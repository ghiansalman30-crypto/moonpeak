{
  "name": "moonpeak",
  "version": "0.1.0",
  "description": "Server-agnostic MCP testing framework and full-stack MCP App framework for ChatGPT Apps, Claude connectors and every MCP Apps host.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "moonpeak": "bin/moonpeak.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/runtime/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./lib/server/index.js"
    },
    "./mcp": {
      "types": "./types/server.d.ts",
      "default": "./lib/server/index.js"
    },
    "./test": {
      "types": "./types/test.d.ts",
      "default": "./lib/test/index.js"
    },
    "./chatgpt": {
      "types": "./types/chatgpt.d.ts",
      "default": "./lib/runtime/chatgpt.js"
    },
    "./claude": {
      "types": "./types/claude.d.ts",
      "default": "./lib/runtime/claude.js"
    },
    "./package.json": "./package.json",
    "./test/client": {
      "types": "./types/test.d.ts",
      "default": "./lib/test/runner.js"
    },
    "./mount": {
      "default": "./lib/runtime/mount.js"
    }
  },
  "files": [
    "bin",
    "lib",
    "inspector",
    "templates",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "chatgpt-apps",
    "claude-connector",
    "testing",
    "inspector",
    "framework",
    "mcp-app",
    "model-context-protocol",
    "chatgpt-app",
    "chatgpt-apps-sdk",
    "mcp-testing",
    "mcp-inspector",
    "react",
    "vite"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "vite": "^7.0.0",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@playwright/test": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "scripts": {
    "prepack": "node scripts-prepack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghiansalman30-crypto/moonpeak.git",
    "directory": "packages/moonpeak"
  },
  "homepage": "https://moonpeak-ai.com",
  "bugs": {
    "url": "https://github.com/ghiansalman30-crypto/moonpeak/issues"
  }
}
